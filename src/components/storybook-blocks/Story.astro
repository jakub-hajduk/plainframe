---
interface StoryLike {
  name?: string
  storyName?: string
  args?: Record<string, unknown>
  component?: unknown
  render?: (args?: Record<string, unknown>) => unknown
}

interface Props {
  name?: string
  of?: StoryLike | unknown
}

const { name, of } = Astro.props as Props
const hasChildren = await Astro.slots.has('default')

const inferred = (of ?? {}) as StoryLike
const storyName = name ?? inferred.storyName ?? inferred.name ?? 'Story'
const storyArgs = inferred.args ?? {}

const StoryComponent = (
  inferred.component ||
  (typeof of === 'function' ? of : null)
) as unknown

let renderedHtml: string | null = null
if (!hasChildren && typeof inferred.render === 'function') {
  try {
    const maybeHtml = inferred.render(storyArgs)
    if (typeof maybeHtml === 'string') {
      renderedHtml = maybeHtml
    }
  } catch {
    renderedHtml = null
  }
}
---

<figure class="sb-story">
  <figcaption>{storyName}</figcaption>

  {hasChildren ? (
    <slot />
  ) : StoryComponent ? (
    <StoryComponent {...storyArgs} />
  ) : renderedHtml ? (
    <div set:html={renderedHtml} />
  ) : (
    <pre>{JSON.stringify(storyArgs, null, 2)}</pre>
  )}
</figure>

<style>
  .sb-story {
    margin: 0;
  }

  .sb-story figcaption {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .sb-story pre {
    margin: 0;
    overflow-x: auto;
  }
</style>

