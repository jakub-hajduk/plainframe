---
interface Props {
  label?: string
  tone?: 'default' | 'success' | 'warning'
}

const { label = 'Badge', tone = 'default' } = Astro.props as Props
---

<span class:list={['storybook-badge', tone]}>{label}</span>

<style>
  .storybook-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    background: #eef2ff;
    color: #3730a3;
    border: 1px solid #c7d2fe;
  }

  .storybook-badge.success {
    background: #ecfdf5;
    color: #065f46;
    border-color: #a7f3d0;
  }

  .storybook-badge.warning {
    background: #fffbeb;
    color: #92400e;
    border-color: #fde68a;
  }
</style>
