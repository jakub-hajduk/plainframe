---
import { resolveStory } from './csf'

interface Props {
  name?: string
  of?: unknown
}

const { name, of } = Astro.props as Props
const hasChildren = await Astro.slots.has('default')

const inferred = resolveStory(of, name)
const storyName = inferred?.name ?? name ?? 'Story'
const storyArgs = inferred?.args ?? {}
const StoryComponent = inferred?.component ?? (typeof of === 'function' ? of : null)
const render = inferred?.render

let renderedHtml: string | null = null
if (!hasChildren && typeof render === 'function') {
  try {
    const maybeHtml = render(storyArgs)
    if (typeof maybeHtml === 'string') {
      renderedHtml = maybeHtml
    }
  } catch {
    renderedHtml = null
  }
}
---

<figure class="sb-story">
  <figcaption>{storyName}</figcaption>

  {hasChildren ? (
    <slot />
  ) : StoryComponent ? (
    <StoryComponent {...storyArgs} />
  ) : renderedHtml ? (
    <div set:html={renderedHtml} />
  ) : (
    <pre>{JSON.stringify(storyArgs, null, 2)}</pre>
  )}
</figure>

<style>
  .sb-story {
    margin: 0;
  }

  .sb-story figcaption {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .sb-story pre {
    margin: 0;
    overflow-x: auto;
  }
</style>
